# PostgreSQL
DATABASE_URL=postgres://tcr:password@db:5432/twitch_follower_role

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session HMAC secret (random string, at least 32 chars)
SESSION_SECRET=

# Twitch API (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch EventSub webhook HMAC secret (10-100 ASCII chars)
TWITCH_EVENTSUB_SECRET=

# Public HTTPS URL where this plugin is reachable
BASE_URL=https://twitch-roles.example.com

# Server bind address (default: 0.0.0.0:8080)
LISTEN_ADDR=0.0.0.0:8080

# Log level (default: twitch_follower_role=info,tower_http=info)
RUST_LOG=twitch_follower_role=info,tower_http=info
