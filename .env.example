# PostgreSQL
DATABASE_URL=postgres://tcr:password@db:5432/twitch_follower_role

# Session HMAC secret (random string, at least 32 chars)
SESSION_SECRET=

# Twitch API (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch EventSub webhook HMAC secret (10-100 ASCII chars)
TWITCH_EVENTSUB_SECRET=

# Public HTTPS URL where this plugin is reachable
BASE_URL=https://twitch-roles.example.com/twitch-follower-role

# Server bind address (default: 0.0.0.0:8080)
LISTEN_ADDR=0.0.0.0:8080

# Auth Gateway integration (required — sync workers call /auth/internal/*)
# Defaults to deriving the origin from BASE_URL if unset. Set explicitly in local dev.
# AUTH_GATEWAY_URL=http://localhost:8090
# Shared secret — must match the Auth Gateway's INTERNAL_API_KEY value
INTERNAL_API_KEY=

# Origin allowed to embed the iframe role-config page (the RoleLogic dashboard).
# Used for the `Content-Security-Policy: frame-ancestors` header and the CORS /
# CSRF origin allowlist. Defaults to https://rolelogic.faizo.net if unset.
# RL_DASHBOARD_ORIGIN=https://rolelogic.faizo.net

# Log level (default: twitch_follower_role=info,tower_http=info)
RUST_LOG=twitch_follower_role=info,tower_http=info
